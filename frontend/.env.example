# API origin (no path). Trailing slash is optional.
# Empty = same-origin. In `npm run dev`, Vite proxies `/api` and `/uploads` to :3000.
#
# Cloudflare Pages: set the same variable in the project Environment variables
# (Production / Preview). It is baked in at build time.
VITE_API_URL=https://api.shenren.de5.net
